{
  "name": "voice-inbox-web",
  "version": "2.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Mikita Kandratsyeu <nickondr.production@gmail.com>",
  "description": "Voice Inbox AI Web API",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=development next dev",
    "build": "prisma generate && next build --webpack",
    "start": "APP_ENV=production next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "prisma generate && next typegen && tsc --noEmit",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "node scripts/db-baseline-migrations.mjs",
    "db:baseline-and-migrate": "node scripts/db-baseline-migrations.mjs --then-deploy",
    "db:seed": "tsx scripts/db-seed-admin.ts",
    "db:rls": "prisma db execute --file prisma/migrations/20260609120000_enable_rls_on_public_tables/migration.sql",
    "db:verify-rls": "tsx scripts/db-verify-rls.ts",
    "db:check-local": "prisma migrate deploy && tsx scripts/db-verify-rls.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "release-post:draft": "tsx scripts/generate-release-post.ts"
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.3",
    "@openrouter/sdk": "^0.13.7",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "^7.9.0",
    "@upstash/qstash": "^2.11.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@zip.js/zip.js": "^2.7.62",
    "bcryptjs": "^3.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "firebase-admin": "^14.0.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "next": "16.3.3",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "openai": "^6.44.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "jest": "^29.7.0",
    "prettier": "^3",
    "prisma": "^7.9.0",
    "puppeteer": "^24.0.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">= 24.x"
  },
  "turbo": {
    "tasks": {
      "type:check": {
        "outputs": [
          "generated/**"
        ]
      }
    }
  }
}
