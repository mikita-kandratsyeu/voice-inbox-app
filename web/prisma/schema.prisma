
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String
  adminLogin String
  action     String
  metadata   Json?

  @@index([createdAt(sort: Desc)])
}

model BroadcastHistory {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  kind           String
  notifyType     String
  title          String?
  bodyPreview    String?  @db.Text
  messagePreview String?  @db.Text
  sent           Int
  failed         Int
  total          Int
  errorSample    String?  @db.Text
  adminId        String
  adminLogin     String
  deviceId       String?

  @@index([createdAt(sort: Desc)])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ReleasePost {
  id          String    @id @default(cuid())
  locale      String
  slug        String
  title       String
  version     String?
  summary     String?   @db.Text
  body        String    @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([locale, slug])
  @@index([locale, published, publishedAt(sort: Desc)])
}

model SupportIssue {
  id           String    @id @default(cuid())
  deviceId     String
  email        String?
  subject      String?
  message      String    @db.Text
  diagnostics  Json
  appLogs      String?   @db.Text
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?

  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
    @@index([status])
  }
  
model ProLicenseKey {
  id                  String    @id @default(cuid())
  keyHash             String    @unique
  durationMonths      Int
  createdAt           DateTime  @default(now())
  createdByAdminId    String
  consumedAt          DateTime?
  consumedByDeviceId  String?

  @@index([createdAt(sort: Desc)])
}

model DeviceProEntitlement {
  deviceId  String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
