generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id             String   @id @default(cuid())
  login          String   @unique
  passwordHash   String
  isSuperadmin   Boolean  @default(false)
  permissions    String[] @default([])
  telegramUserId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String
  adminLogin String
  action     String
  metadata   Json?

  @@index([createdAt(sort: Desc)])
}

model BroadcastHistory {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  kind           String
  notifyType     String
  title          String?
  bodyPreview    String?  @db.Text
  messagePreview String?  @db.Text
  sent           Int
  failed         Int
  total          Int
  errorSample    String?  @db.Text
  adminId        String
  adminLogin     String
  deviceId       String?

  @@index([createdAt(sort: Desc)])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ReleasePost {
  id          String    @id @default(cuid())
  locale      String
  slug        String
  title       String
  version     String?
  summary     String?   @db.Text
  body        String    @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([locale, slug])
  @@index([locale, published, publishedAt(sort: Desc)])
}

model SupportIssue {
  id                       String    @id @default(cuid())
  referenceNumber          Int       @unique @default(autoincrement())
  deviceId                 String
  email                    String?
  subject                  String?
  message                  String    @db.Text
  diagnostics              Json
  appLogs                  String?   @db.Text
  status                   String    @default("open")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  closedAt                 DateTime?
  proLicenseEmailSentAt    DateTime?
  proLicenseDurationMonths Int?
  proLicenseDurationDays   Int?

  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model ProLicenseKey {
  id                     String    @id @default(cuid())
  keyHash                String    @unique
  durationMonths         Int
  durationDays           Int?
  createdAt              DateTime  @default(now())
  createdByAdminId       String
  issuedToEmail          String?
  adminNotes             String?   @db.Text
  /**
   * Set when the key is issued as a printable gift voucher (one batch per print/email run).
   */
  voucherBatchId         String?
  /**
   * Voucher PDF template version at issue time (e.g. v2).
   */
  voucherTemplateVersion String?
  consumedAt             DateTime?
  consumedByDeviceId     String?

  @@index([createdAt(sort: Desc)])
  @@index([voucherBatchId])
}

model DeviceProEntitlement {
  deviceId  String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model AiUsageLedgerEntry {
  id          String   @id @default(cuid())
  deviceId    String
  createdAt   DateTime @default(now())
  kind        String
  operation   String
  amount      Int
  jobId       String?
  description String?
  metadata    Json?

  @@index([deviceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([jobId])
}

model AdminBudgetExpense {
  id          String   @id @default(cuid())
  spentAt     DateTime @default(now())
  category    String?
  description String
  amountCents Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spentAt(sort: Desc)])
  @@index([currency])
}
