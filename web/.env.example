OPENROUTER_API_KEY=

# App secret for API
APP_SECRET=
APP_SECRET_LEGACY=

# Store links (landing page)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BASE_URL=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional: Yandex Metrika counter ID (for analytics)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional: Omit for local development — uses in-memory cache instead
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: iOS Push Notifications (APNs) — required for push when AI completes
# Create APNs key in Apple Developer → Certificates, Identifiers & Profiles → Keys
# Local: use APNS_KEY_PATH (path to .p8 file, e.g. AuthKey_XXX.p8)
# Vercel: use APNS_KEY_CONTENT (full key content as env var)
APNS_KEY_PATH=
APNS_KEY_CONTENT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
