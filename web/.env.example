OPENROUTER_API_KEY=

# App secret for API (used only to obtain JWT from POST /api/token)
APP_SECRET=
# JWT for API auth; must be set and at least 32 characters
JWT_SECRET=
# Optional: mobile app JWT expiry, e.g. 1h, 12h, 24h (default 12h)
JWT_EXPIRES_IN=
MOBILE_USER_AGENT=

# Store links (landing page)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BASE_URL=

# Optional: Yandex Metrika counter ID (for analytics)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional: Google Analytics measurement ID (gtag), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional: Firebase project ID for admin deep links — Crashlytics, FCM, Remote Config (same ID as in GoogleService-Info.plist / console URL)
NEXT_PUBLIC_FIREBASE_CONSOLE_PROJECT_ID=

# Optional: Omit for local development — uses in-memory cache instead
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon PostgreSQL (Prisma) — admin accounts + AppConfig (technical keys only; no mobile user data)
# Add uselibpqcompat=true with sslmode=require to match libpq SSL semantics and silence pg v8 warnings on Vercel.
# Example: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Admin panel JWT session (recommended with DATABASE_URL). Min 32 chars. Falls back to JWT_SECRET.
ADMIN_JWT_SECRET=
# Optional admin session TTL, e.g. 24h (default 24h)
ADMIN_JWT_EXPIRES_IN=

# Optional: Vercel API — for admin status (deployments list). Token: Vercel → Settings → Tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Optional: GitHub — for admin (recent commits). Repo: owner/repo. Token: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_REPO=
GITHUB_TOKEN=

# RevenueCat webhook: same token as in RC → Integrations → Webhooks → authorization (RC may send Bearer <token> or raw token)
# REVENUECAT_WEBHOOK_SECRET=
# Optional; must match mobile / RC entitlement id (default pro)
# REVENUECAT_ENTITLEMENT_ID=pro
# Secret API key (Project settings → API keys): server pulls subscriber after restore/purchase when webhooks lag (POST /api/pro-license/sync-revenuecat)
# REVENUECAT_SECRET_API_KEY=

# Push Notifications (Firebase Cloud Messaging)
# Firebase Console → Project Settings → Service Accounts → Generate new key.
# For Vercel: paste entire JSON as FIREBASE_SERVICE_ACCOUNT (escape newlines as \n).
FIREBASE_SERVICE_ACCOUNT=
