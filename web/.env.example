OPENROUTER_API_KEY=
# Required when clients use DeepSeek (deepseek/deepseek-v4-flash, deepseek/deepseek-v4-pro): direct API, not OpenRouter.
# OpenAI SDK + https://api.deepseek.com — see https://api-docs.deepseek.com/
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MAX_TOKENS=32768

# App secret for API (used only to obtain JWT from POST /api/token)
APP_SECRET=
# Optional: HS256 secret for short-lived Pro account portal links (defaults to APP_SECRET if unset)
PRO_ACCOUNT_PORTAL_SECRET=
# JWT for API auth; must be set and at least 32 characters
JWT_SECRET=
# Optional: mobile app JWT expiry, e.g. 1h, 12h, 24h (default 12h)
JWT_EXPIRES_IN=
# Substring checked on User-Agent from the app (see mobile MOBILE_USER_AGENT). Use product token only, e.g. VoiceInbox-Mobile — not the full version string.
MOBILE_USER_AGENT=

# Store links (landing page)
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Optional: numeric App Store id for iOS Smart App Banner on the landing home page only (defaults to id parsed from NEXT_PUBLIC_APP_STORE_URL)
NEXT_PUBLIC_APP_STORE_APP_ID=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
# When Play is not public yet: waitlist URL (Typeform, Google Form, etc.). Used for /go on Android when GOOGLE_PLAY_URL is unset (voucher QR).
NEXT_PUBLIC_ANDROID_WAITLIST_URL=
# Optional: App Store Connect → Verified Metrics → public link (shown in site footer when set)
NEXT_PUBLIC_VERIFIED_METRICS_URL=

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=

# Outbound email (Pro license emails from admin — Nodemailer)
# MAIL_FROM must be a full address, e.g. Voice Inbox <noreply@yourdomain.com>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# Set to true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: Yandex Metrika counter ID (for analytics)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional: Google Analytics measurement ID (gtag), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional: Firebase project ID for admin deep links — Crashlytics, FCM, Remote Config (same ID as in GoogleService-Info.plist / console URL)
NEXT_PUBLIC_FIREBASE_CONSOLE_PROJECT_ID=

# Optional: Omit for local development — uses in-memory cache instead
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Upstash QStash — async AI jobs (summarize, ask, auto-organize). Without QSTASH_TOKEN, jobs use Next.js after().
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# AI_JOB_TRANSPORT=qstash
# Local QStash dev tunnel: QSTASH_URL=http://127.0.0.1:8080

# Supabase PostgreSQL (Prisma) — admin accounts + AppConfig (technical keys only; no mobile user data)
# Optional `telegram-bot/`: links Telegram users via AdminUser.telegramUserId (Security → Admin users).
# Shared secret for telegram-bot → /api/admin/* (Authorization: Bearer … + X-Telegram-User-Id header). Set the same value in telegram-bot/.env.
# TELEGRAM_BOT_API_SECRET=
# Bot sends User-Agent VoiceInbox-Bot/… (override via telegram-bot TELEGRAM_BOT_USER_AGENT). Vercel Firewall: Bypass when User Agent Contains that token (like MOBILE_USER_AGENT for the app).
# App / Prisma Client (Vercel): transaction pooler :6543 — pgbouncer=true disables prepared statements.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Migrations, yarn db:backup / db:restore: session pooler :5432 (Supabase → Connect → Session mode).
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Plain password in .env is OK (@, ^, * etc. are encoded automatically). Or reset to alphanumeric-only.
DIRECT_URL=

# First superadmin (only when AdminUser table is empty): yarn db:seed
ADMIN_SEED_LOGIN=
ADMIN_SEED_PASSWORD=

# Admin panel JWT session (recommended with DATABASE_URL). Min 32 chars. Falls back to JWT_SECRET.
ADMIN_JWT_SECRET=
# Optional admin session TTL, e.g. 24h (default 24h)
ADMIN_JWT_EXPIRES_IN=

# Optional: Vercel API — for admin status (deployments list). Token: Vercel → Settings → Tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Optional: GitHub — for admin (recent commits). Repo: owner/repo. Token: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_REPO=
GITHUB_TOKEN=

# RevenueCat webhook: same token as in RC → Integrations → Webhooks → authorization (RC may send Bearer <token> or raw token)
# REVENUECAT_WEBHOOK_SECRET=
# Optional; must match mobile / RC entitlement id (default pro)
# REVENUECAT_ENTITLEMENT_ID=pro
# Secret API key (Project settings → API keys): server pulls subscriber after restore/purchase when webhooks lag (POST /api/pro-license/sync-revenuecat)
# REVENUECAT_SECRET_API_KEY=

# Push Notifications (Firebase Cloud Messaging)
# Firebase Console → Project Settings → Service Accounts → Generate new key.
# For Vercel: paste entire JSON as FIREBASE_SERVICE_ACCOUNT (escape newlines as \n).
FIREBASE_SERVICE_ACCOUNT=

# Optional: max UTF-16 units per translate API chunk (default 4000).
# TRANSLATE_CHUNK_MAX_CHARS=4000

# Optional: auto AI model routing thresholds (chars). Short → GPT-5.4 Nano, medium → DeepSeek V4 Flash, long → Gemini 3.1.
# AI_ROUTE_SUMMARY_MEDIUM_CHARS=8000
# AI_ROUTE_SUMMARY_LONG_CHARS=14000
# AI_ROUTE_ASK_MEDIUM_CHARS=5000
# AI_ROUTE_ASK_LONG_CHARS=9000
