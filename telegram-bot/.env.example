# From @BotFather
TELEGRAM_BOT_TOKEN=

# Same Postgres as web (AdminUser.telegramUserId lookup)
DATABASE_URL=

# Web app origin for admin API calls (no trailing path)
WEB_ADMIN_URL=https://your-domain.com

# Shared secret — must match web TELEGRAM_BOT_API_SECRET
TELEGRAM_BOT_API_SECRET=

# User-Agent product token for Vercel Firewall (rule: User Agent Contains this value).
# Default: VoiceInbox-Bot → User-Agent VoiceInbox-Bot/<package version>
# TELEGRAM_BOT_USER_AGENT=VoiceInbox-Bot

# Optional: external console URLs for Operations → Console links
# ADMIN_LINK_APPLE=

# Optional: proactive new-ticket alerts (polls every 2 min for opted-in admins)
# TELEGRAM_BOT_SUPPORT_ALERTS=false

# Optional: webhook mode (production). When set, long polling is disabled.
# TELEGRAM_BOT_WEBHOOK_URL=https://your-host.example/telegram-webhook
# TELEGRAM_BOT_WEBHOOK_SECRET=
# TELEGRAM_BOT_WEBHOOK_PATH=/telegram-webhook
# PORT=3001
# ADMIN_LINK_FIREBASE=
# ADMIN_LINK_REVENUECAT=
# ADMIN_LINK_VERCEL=
# ADMIN_LINK_NEON=
# ADMIN_LINK_UPSTASH=
# ADMIN_LINK_OPENROUTER=
# ADMIN_LINK_HUGGINGFACE=
# ADMIN_LINK_GITHUB=
