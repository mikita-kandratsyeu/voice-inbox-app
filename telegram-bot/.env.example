# From @BotFather
TELEGRAM_BOT_TOKEN=

# Same Postgres as web (read-only role recommended). Used only to read AppConfig TELEGRAM_ADMIN_USER_IDS.
DATABASE_URL=

# Optional: how long to cache whitelist in memory (seconds). Default 600 (10 min). Max 86400.
# TELEGRAM_WHITELIST_CACHE_SECONDS=

# Optional: rows written to AdminAuditLog when closing/reopening support from the bot (defaults below).
# TELEGRAM_BOT_AUDIT_LOGIN=
# TELEGRAM_BOT_AUDIT_ID=

# Optional: https admin URL for the Telegram Mini App button on /admin (home + Pro keys). Use WEB_ADMIN_URL when it is https, or set only WEB_ADMIN_MINI_APP_URL.
# WEB_ADMIN_URL=https://your-domain.com/en/admin
# Optional: Mini App URL only (must be https). Defaults to WEB_ADMIN_URL when that value is https.
# WEB_ADMIN_MINI_APP_URL=
