<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="start_recording"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_start_recording_short"
        android:shortcutLongLabel="@string/shortcut_start_recording_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="voiceinbox://record/start"
            android:targetPackage="com.voiceinputapp"
            android:targetClass="com.voiceinputapp.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
