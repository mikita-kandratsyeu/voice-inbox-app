# App
APP_ENV=

# Links
WEBSITE_URL=
# Staging/preview public site. Used when WEB_API_TARGET=preview (Firebase Remote Config in release).
PREVIEW_WEBSITE_URL=
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Web API (for AI summary/tasks processing)
WEB_API_URL=
# Staging/preview API host. Used when WEB_API_TARGET=preview (Firebase Remote Config in release).
PREVIEW_WEB_API_URL=
# prod (default) or preview. Switches WEB_API_URL + WEBSITE_URL together. Release: Firebase Remote Config key WEB_API_TARGET.
WEB_API_TARGET=prod
# Product token only; app version is appended at runtime from the native build (iOS MARKETING_VERSION / Android versionName).
# Example: VoiceInbox-Mobile → User-Agent VoiceInbox-Mobile/1.2.3
MOBILE_USER_AGENT=

# Yandex Mobile Ads (banner + rewarded + interstitial; skipped when user has Pro / ad-free entitlement)
# Rewarded ad (Settings → AI bonus). Testing: demo-rewarded-yandex
YANDEX_REWARDED_AD_UNIT_ID=
# Banner on note detail screen. Testing: demo-banner-yandex
YANDEX_BANNER_AD_UNIT_ID=
# Interstitial after note save, import, auto-organize (with caps). Testing: demo-interstitial-yandex
YANDEX_INTERSTITIAL_AD_UNIT_ID=

# Database (for drizzle-kit studio when inspecting copied DB)
DATABASE_URL=

# Debug
DB_LOG=

# Firebase App Check (debug builds): register token in Firebase Console → App Check → Manage debug tokens.
# Omit to use auto token from device logs (adb logcat / Xcode) on first run.
FIREBASE_APP_CHECK_DEBUG_TOKEN=
# Local dev: skip client App Check on API calls (__DEV__ only). Set the same flag in web/.env.
SKIP_FIREBASE_APP_CHECK=1

# Send Crashlytics reports from debug builds too (default: only release). Requires `mobile/firebase.json`.
CRASHLYTICS_DEBUG=

# Send Firebase Analytics from debug builds too (default: only release).
ANALYTICS_DEBUG=

# Internal TestFlight only: enables “Activate Pro”, internal tech panel, and manual Web API host override in Settings. Omit for App Store build.
TESTFLIGHT_INTERNAL_BUILD=

# Pro license key entry (About → tap app icon quickly 8×). Separate from IAP; disabled when user has store subscription.
# Release builds: overridden by Firebase Remote Config key PRO_LICENSE_KEY_ACTIVATION_ENABLED (1/0, true/false).
PRO_LICENSE_KEY_ACTIVATION_ENABLED=

# RevenueCat. Public SDK keys from RC dashboard.
# Same keys are used for production, App Store / Play sandbox, and local StoreKit / license testers.
# Embedded defaults; release builds: same parameter names in Firebase Remote Config override these after fetch.
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
# Optional: must match entitlement id in RC (default pro).
REVENUECAT_ENTITLEMENT_ID=
# Optional: ANNUAL | MONTHLY | WEEKLY | LIFETIME | SIX_MONTH | THREE_MONTH | TWO_MONTH
REVENUECAT_PACKAGE_TYPE_PREFERRED=

# Consumable product id for Pro weekly AI limit reset (must match App Store / Play + RevenueCat + web REVENUECAT_AI_RESET_PRODUCT_ID).
REVENUECAT_AI_RESET_PRODUCT_ID=

# GitHub OAuth App (Device Flow) — Pro note sync to user repository. Scope: repo.
# Embedded default; release builds: same parameter name in Firebase Remote Config overrides after fetch.
GITHUB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_ID=

# App Store Connect: create subscriptions with the same product ids as in RevenueCat offerings.
# Google Play: same product ids; use license testing for sandbox.
# Webhook (server): set REVENUECAT_WEBHOOK_SECRET in web/.env and point RC webhook to /api/webhooks/revenuecat (use ngrok for local web).