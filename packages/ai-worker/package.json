{
  "name": "@voice-inbox/ai-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./services/*": "./src/services/*.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.mjs",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.13.7",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/qstash": "^2.11.1",
    "@upstash/redis": "^1.38.0",
    "@voice-inbox/ai-job-core": "workspace:*",
    "firebase-admin": "^14.0.0",
    "openai": "^6.44.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "esbuild": "0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
